{
  "name": "dealflow360",
  "private": true,
  "scripts": {
    "typecheck": "tsc -b packages/contracts apps/api",
    "test": "jest --config apps/api/jest.config.js",
    "prisma:generate": "prisma generate --schema prisma/schema",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema",
    "seed": "ts-node -r tsconfig-paths/register prisma/seed/index.ts",
    "dev:api": "ts-node -r tsconfig-paths/register apps/api/src/main.ts",
    "dev:web": "npm --prefix apps/web run dev"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.0",
    "jest": "^29.7.0",
    "prisma": "^5.14.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@prisma/client": "^5.14.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  }
}
