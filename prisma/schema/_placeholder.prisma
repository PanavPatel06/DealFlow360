// NOT B3's. Delete this whole file at the first integration with B1 and B2, and
// keep sales.prisma / intelligence.prisma instead. It exists only so the B3
// branch compiles, migrates and runs on its own. Only the columns B3 actually
// reads are declared here.
// ponytail: placeholder schema, delete on integration, one file not many edits.

model CustomerTier {
  id        String     @id @default(cuid())
  name      String     @unique
  customers Customer[]
}

model Customer {
  id         String      @id @default(cuid())
  name       String
  tierId     String
  tier       CustomerTier @relation(fields: [tierId], references: [id])
  quotations Quotation[]

  @@map("customers")
}

model Quotation {
  id           String          @id @default(cuid())
  code         String          @unique
  customerId   String
  customer     Customer        @relation(fields: [customerId], references: [id])
  status       QuoteStatus     @default(DRAFT)
  currency     String          @db.Char(3)
  portalToken  String?         @unique
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  lines        QuotationLine[]
  negotiation  Negotiation?

  @@map("quotations")
}

model QuotationLine {
  id             String    @id @default(cuid())
  quotationId    String
  quotation      Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product   @relation(fields: [productId], references: [id])
  description    String
  qty            Int
  unitPriceMinor Int
  discountBps    Int       @default(0)
  lineTotalMinor Int
  costMinor      Int       @default(0)
  lineType       LineType  @default(ONE_TIME)

  @@map("quotation_lines")
}

model Order {
  id            String         @id @default(cuid())
  code          String         @unique
  quotationId   String
  customerId    String
  status        String
  currency      String         @db.Char(3)
  createdAt     DateTime       @default(now())
  lines         OrderLine[]
  fulfillments  Fulfillment[]
  invoices      Invoice[]
  subscriptions Subscription[]

  @@map("orders")
}

model OrderLine {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  description    String
  qty            Int
  unitPriceMinor Int
  discountBps    Int      @default(0)
  lineTotalMinor Int
  costMinor      Int      @default(0)
  lineType       LineType @default(ONE_TIME)

  @@map("order_lines")
}
